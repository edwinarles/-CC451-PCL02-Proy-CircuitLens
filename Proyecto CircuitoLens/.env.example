# ====================================================================
# CircuitLens Enterprise Environment Configuration
# ====================================================================

PORT=8000
NODE_ENV=production

# --------------------------------------------------------------------
# 1. Supabase (PostgreSQL) Cloud Configuration
# Reemplaza con las credenciales de tu proyecto Supabase si se desea desplegar en la nube
# --------------------------------------------------------------------
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
DATABASE_URL=postgresql://postgres:yourpassword@db.yourproject.supabase.co:5432/postgres

# --------------------------------------------------------------------
# 2. AI Tutor LLM Providers
# Providers soportados: gemini | openai | ollama | sim (Motor heurístico)
# --------------------------------------------------------------------
DEFAULT_LLM_PROVIDER=gemini

# Google Gemini API (gemini-1.5-flash / gemini-2.0-flash)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# OpenAI / OpenAI-compatible (DeepSeek, Groq, OpenRouter, LocalAI)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Ollama Inferencia Local Privada
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2

# --------------------------------------------------------------------
# 3. Collaboration & Default Workspaces
# --------------------------------------------------------------------
DEFAULT_ROOM_ID=SALA-ELECTRO-1

# --------------------------------------------------------------------
# 4. Bootstrap Teacher Account
# --------------------------------------------------------------------
BOOTSTRAP_TEACHER_EMAIL=docente@circuitlens.edu.pe
BOOTSTRAP_TEACHER_NAME=Prof. Edwin Requena
BOOTSTRAP_TEACHER_PASSWORD=CircuitLens2026!

