# Configuración de CircuitLens (Opcional)
# El sistema funciona 100% offline y de forma autónoma con el motor heurístico local simulado (sim).
# Si deseas conectar modelos LLM remotos o locales, completa tus credenciales aquí:

DEFAULT_LLM_PROVIDER=sim

# Google Gemini API (gemini-1.5-flash / gemini-2.0-flash)
GEMINI_API_KEY=

# Anthropic Claude API (claude-3-5-sonnet)
ANTHROPIC_API_KEY=

# OpenAI API (gpt-4o-mini)
OPENAI_API_KEY=

# Ollama Inferencia Soberana Local
OLLAMA_HOST=http://localhost:11434
